{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openprompting.dev/schemas/config.schema.json",
  "title": "openPrompting project configuration",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "setups"],
  "properties": {
    "version": { "const": 1 },
    "setups": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "harness"],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "harness": { "type": "string", "minLength": 1 }
        }
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uses"],
        "properties": {
          "uses": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
